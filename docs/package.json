{
  "name": "@stacc/docs",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "postcss": "8.5.15"
  },
  "reactDoctor": {
    "ignore": {
      "files": [
        "out/**",
        "public/**",
        "source/**"
      ]
    }
  },
  "scripts": {
    "sync:install-script": "node scripts/sync-install-script.mjs",
    "predev": "npm run sync:install-script",
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 4174",
    "prebuild": "npm run sync:install-script",
    "build": "next build",
    "postbuild": "node scripts/sync-static-export.mjs",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "doctor": "react-doctor"
  },
  "dependencies": {
    "cmdk": "^1.1.1",
    "next": "16.2.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "satteri": "^0.9.3",
    "shiki": "^4.2.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "25.0.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "postcss": "8.5.15",
    "react-doctor": "^0.5.8",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3"
  }
}
